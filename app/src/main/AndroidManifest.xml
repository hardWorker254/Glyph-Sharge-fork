<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="com.nothing.ketchum.permission.ENABLE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.NFC" />

    <!-- Fetching the animation store's index and the scripts it offers. This
         is the only thing the app uses the network for: a script the user
         writes is stored locally and the Lua sandbox never reaches a socket, so
         nothing that runs on the glyph can talk to anything. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Watching the VPN transport: Android broadcasts no "VPN connected"
         event, so the feature registers a NetworkCallback for TRANSPORT_VPN,
         which only needs the network state, not the network itself. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The visualiser reads the audio other apps are playing through a
         MediaProjection + AudioRecord pair, which Android gates behind the
         microphone permission. The audio becomes a spectrum in memory and is
         never stored.

         FOREGROUND_SERVICE_MEDIA_PROJECTION goes with it: a projection token
         can only be used by a foreground service of the mediaProjection
         type. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <!-- Support for high refresh rate displays -->
    <uses-feature
        android:name="android.hardware.touchscreen.multitouch"
        android:required="false" />

    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="true" />

    <application
        android:name=".GlyphShargeApplication"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GlyphSharge"
        android:largeHeap="true"
        >

        <!-- Nothing Glyph API Key (use "test" for debugging) -->
        <meta-data
            android:name="NothingKey"
            android:value="3ba6b42560e7442c9475d8029807158e" />

        <!-- FileProvider for sharing log files -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.GlyphSharge"
            android:windowSoftInputMode="adjustResize"
            android:hardwareAccelerated="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Animation studio: a separate Activity rather than a route in the
             settings NavHost, because it has its own back stack and its own
             system file pickers. Not exported: nothing outside the app may
             open a code editor. -->
        <activity
            android:name=".CustomAnimationsActivity"
            android:exported="false"
            android:theme="@style/Theme.GlyphSharge"
            android:windowSoftInputMode="adjustResize"
            android:hardwareAccelerated="true"
            android:parentActivityName=".MainActivity" />

        <!-- The rule constructor, for the same reason the studio is one: it
             has two front doors — the home list's "＋" and the settings card —
             and a form to fill in. Not exported: a rule is written from
             inside the app, and an implicit intent that could open the editor
             for a rule the user never chose is exactly the kind of entry point
             that does not belong. -->
        <activity
            android:name=".RuleConstructorActivity"
            android:exported="false"
            android:theme="@style/Theme.GlyphSharge"
            android:windowSoftInputMode="adjustResize"
            android:hardwareAccelerated="true"
            android:parentActivityName=".MainActivity" />

        <!-- The catalogue, reached from Settings. Its own Activity rather than a
             route inside the settings NavHost because of "Test on glyph": that
             button previews on the real strip, which needs a session, and
             MainActivity only restores one while the master switch is on — so
             a store living in the NavHost would report a preview that drew
             nothing. Not exported: the catalogue is read from inside the app,
             and an implicit intent that could open an install screen is exactly
             the kind of entry point that does not belong. -->
        <activity
            android:name=".ScriptStoreActivity"
            android:exported="false"
            android:theme="@style/Theme.GlyphSharge"
            android:hardwareAccelerated="true"
            android:parentActivityName=".MainActivity" />

        <receiver
            android:name=".receiver.BootCompletedReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Every `specialUse` service needs a subtype property, including this
             one: the Play Console rejects a submission that declares the type
             without describing what it is for. This declaration had been
             missing while the two copy-pasted neighbours below it were given
             the right text. -->
        <service
            android:name=".services.GlyphForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse" >
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Holds the Glyph hardware session open for as long as the master switch is on." />
        </service>


        <!-- The generic rule host: one foreground service that runs every
             user-defined rule. Each rule is a trigger plus an animation the user
             named in the constructor. -->
        <service
            android:name=".services.RuleHostService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse" >
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="This service runs the user's automation rules, firing a chosen glyph animation when a chosen trigger happens." />
        </service>

        <!-- Music visualiser foreground service.
             mediaProjection | specialUse: the first half is what lets the app
             read other apps' audio at all — without a token there is nothing to
             capture — and the second keeps the feature eligible for the glyph
             rendering it actually performs. -->
        <service
            android:name=".services.MusicVisualizerService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|specialUse" >
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="This service analyses the audio the device is currently playing and renders a spectrum visualisation on the glyph interface." />
        </service>

        <!-- Quick Settings tiles: the master Glyph switch and the music
             visualiser, two of them, which is the documented ceiling per app.

             BIND_QUICK_SETTINGS_TILE is what keeps the service reachable only
             by the system; exported="true" is still required for the tile to
             appear in the shade at all. ACTIVE_TILE leaves the service bound
             so a switch moved elsewhere reaches the tile without waiting for
             the shade to be opened, and TOGGLEABLE_TILE tells the system this
             is a two-state switch rather than an action. -->
        <service
            android:name=".tiles.GlyphServiceTileService"
            android:exported="true"
            android:icon="@drawable/_44"
            android:label="@string/tile_glyph_service_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>

            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <service
            android:name=".tiles.MusicVisualizerTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_music"
            android:label="@string/tile_music_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>

            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

    </application>

</manifest>