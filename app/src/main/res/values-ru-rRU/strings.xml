  <string name="studio_starter_script">-- Волна по длинной полосе C.\n-- Весь файл и есть анимация: пишите на Lua.\n-- Проигрывается один раз и заканчивается, когда кончится код.\n-- Попробуйте заменить 600 или оба числа внутри util.lerp.\n\nlocal util = require(\"glyph.util\")\n\nlocal strip = glyph.ch.c\nlocal n = #strip\n\n-- Полоса C — это 4 сегмента на Phone (1) и 24 на Phone (2a), поэтому шаг\n-- считается от её длины: один проход занимает примерно одинаковое время на\n-- любом телефоне. Фиксированные 60 мс ползли бы по маленькому и сливались бы\n-- на большом.\nlocal step = math.max(25, math.floor(600 / n))\n\n-- util.lerp даёт каждому сегменту свою яркость, поэтому у волны есть голова\n-- и хвост, а не все сегменты горят одинаково.\nfor i = 1, n do\n  glyph.set({ strip[i] }, util.lerp(1000, glyph.MAX, i / n), step)\nend\n\n-- Гасим всю полосу по одному сегменту.\nfor i = n, 1, -1 do\n  glyph.set({ strip[i] }, util.lerp(1000, glyph.MAX, i / n), step)\nend</string>
